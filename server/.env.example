DATABASE_URL="postgresql://goldloan:goldloan@localhost:5433/goldloan?schema=public"
PORT=4000

# Which LLM runs the Loan Assist agent: gemini (default) or groq
LLM_PROVIDER=gemini

GEMINI_API_KEY="your-key-here"
